# Copy to .env (git-ignored) or export in the environment. Never commit real keys.

# --- Required, both providers ---
PROXY_TOKENS=change-me-long-random-token

# --- Provider selection (default anthropic) ---
LLM_PROVIDER=anthropic

# --- anthropic (default) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-haiku-5-5

# --- openai (any OpenAI-compatible server) ---
# LLM_PROVIDER=openai
# LLM_MODEL=REPLACE_WITH_MODEL_ID
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-REPLACE_ME      # optional for local servers
# LLM_TIMEOUT_MS=20000

# --- Speech-to-text (POST /v1/audio/transcriptions). Unset = 501 not_configured ---
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=sk-REPLACE_ME          # optional for local servers
# STT_MODEL=whisper-1
# STT_TIMEOUT_MS=30000

# --- Common ---
# RATE_LIMIT_PER_MIN=30
# PORT=8787
# DEBUG_LOG_TEXT=0                  # 1 logs request text (dev only)
